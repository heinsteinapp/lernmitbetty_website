---
import Layout from '../layouts/Layout.astro';
import { APPS, CONTACT_EMAIL, WEB3FORMS_ACCESS_KEY, MAX_DAILY_FEEDBACK, FEEDBACK_COOLDOWN_SECONDS } from '../data/apps';

const pageTitle = "Wünsche dir ein Feature – Lern mit Betty";
const pageDescription = "Hast du eine Idee für Fokus mit Betty, Rechne mit Betty, Englisch mit Betty oder Betty's Slice? Reiche deinen Feature-Wunsch mit Bildern oder Skizzen direkt ein!";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back Link -->
      <div class="mb-8">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 text-sm font-semibold text-[#00897B] hover:text-[#FF8A34] transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          Zurück zur Übersicht
        </a>
      </div>

      <!-- Hero Card -->
      <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-white to-[#F0FCFB] border-2 border-[#58CBBF]/25 p-8 sm:p-10 shadow-sm mb-10">
        <div class="flex flex-col sm:flex-row items-center gap-6">
          <div class="w-28 h-28 sm:w-32 sm:h-32 flex-shrink-0 rounded-3xl bg-white p-2 shadow-md border-2 border-[#58CBBF]/20 overflow-hidden">
            <img 
              src="/images/mascot/betty_mascot_welcome.png" 
              alt="Hündin Betty freut sich auf deine Ideen" 
              class="w-full h-full object-cover"
            />
          </div>
          <div class="text-center sm:text-left">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-[#FF8A34]/15 text-[#FF8A34] mb-2">
              💡 Mitgestalten & Mitbestimmen
            </span>
            <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1A3533] mb-2" style="font-family: var(--font-heading);">
              Wünsche dir ein Feature<span class="text-[#FF8A34]">!</span>
            </h1>
            <p class="text-sm sm:text-base text-[#4B6E6A] leading-relaxed">
              Welche neuen Aufgaben, Spiele oder Funktionen wünschst du dir für unsere Apps? Wir entwickeln Betty für euch und freuen uns riesig über eure Skizzen, Ideen und Wünsche!
            </p>
          </div>
        </div>
      </div>

      <!-- Rate Limit / Pausen-Warnung (wird per JS eingeblendet, falls Limit erreicht) -->
      <div id="rate-limit-notice" class="hidden mb-8 p-6 rounded-2xl bg-amber-50 border-2 border-amber-200 text-amber-900">
        <div class="flex items-start gap-4">
          <span class="text-3xl">🐶🐾</span>
          <div>
            <h3 class="text-lg font-bold mb-1" style="font-family: var(--font-heading);">
              Betty macht gerade ein kleines Päuschen!
            </h3>
            <p class="text-sm text-amber-800" id="rate-limit-message">
              Du hast heute schon fleißig Ideen eingereicht. Bitte warte einen kurzen Moment, bevor du wieder neue Vorschläge schicken kannst.
            </p>
          </div>
        </div>
      </div>

      <!-- Success Card (Hidden by Default) -->
      <div id="feedback-success" class="hidden rounded-[2.5rem] bg-white border-2 border-[#58CBBF]/30 p-8 sm:p-12 shadow-lg text-center">
        <div class="w-32 h-32 mx-auto rounded-3xl bg-[#F0FCFB] p-2 shadow-inner border border-[#58CBBF]/20 mb-6 overflow-hidden">
          <img 
            src="/images/mascot/betty_praise.png" 
            alt="Betty lobt deine Idee" 
            class="w-full h-full object-cover"
          />
        </div>
        <span class="text-xs font-bold uppercase tracking-wider text-[#00897B] bg-[#F0FCFB] px-3 py-1 rounded-full border border-[#58CBBF]/20">
          Erfolgreich übertragen!
        </span>
        <h2 class="text-3xl font-extrabold text-[#1A3533] mt-3 mb-2" style="font-family: var(--font-heading);">
          Vielen lieben Dank! 🐾🎉
        </h2>
        <p class="text-sm sm:text-base text-[#4B6E6A] max-w-md mx-auto mb-8 leading-relaxed">
          Deine Idee ist sicher bei uns gelandet. Wir schauen uns jeden Vorschlag ganz genau an und prüfen, wie wir ihn in die Betty-Apps einbauen können.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <button 
            type="button" 
            id="btn-another-idea"
            class="w-full sm:w-auto px-6 py-3 rounded-full bg-[#FF8A34] hover:bg-[#E67520] text-white font-bold text-sm shadow-md transition-all"
            style="font-family: var(--font-heading);"
          >
            💡 Noch eine Idee einreichen
          </button>
          <a 
            href="/"
            class="w-full sm:w-auto px-6 py-3 rounded-full bg-[#F0FCFB] hover:bg-[#E0F7F5] text-[#00897B] font-bold text-sm border border-[#58CBBF]/30 transition-all text-center"
            style="font-family: var(--font-heading);"
          >
            Zurück zu den Apps
          </a>
        </div>
      </div>

      <!-- Feedback Form Card -->
      <div id="feedback-form-container" class="rounded-[2.5rem] bg-white border-2 border-[#58CBBF]/25 p-6 sm:p-10 shadow-md">
        
        <form id="feedback-form" class="space-y-6" enctype="multipart/form-data">
          <!-- Web3Forms Config -->
          <input type="hidden" name="access_key" id="access_key" value={WEB3FORMS_ACCESS_KEY} />
          <input type="hidden" name="subject" id="email-subject" value="💡 Neue Betty-Idee über Website" />
          <input type="hidden" name="from_name" value="Lern mit Betty Portal" />
          
          <!-- Anti-Abuse Honeypot (Hidden for Humans, filled by Bots) -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

          <!-- 1. App Auswahl -->
          <div>
            <label for="app-select" class="block text-sm font-bold text-[#1A3533] mb-2" style="font-family: var(--font-heading);">
              1. Für welche App ist deine Idee? <span class="text-[#FF8A34]">*</span>
            </label>
            <div class="relative">
              <select 
                id="app-select" 
                name="app" 
                required
                class="w-full px-4 py-3 rounded-2xl bg-[#F0FCFB]/60 border-2 border-[#58CBBF]/30 text-sm font-semibold text-[#1A3533] focus:outline-none focus:border-[#00897B] transition-colors appearance-none cursor-pointer"
              >
                <option value="" disabled selected>Bitte App auswählen...</option>
                {APPS.map((app) => (
                  <option value={app.id}>{app.name} ({app.category})</option>
                ))}
                <option value="neue-app">✨ Eine ganz neue App-Idee für Betty</option>
                <option value="allgemein">💬 Allgemeines Feedback / Gesamte Plattform</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-[#527976]">
                <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- 2. Kategorie -->
          <div>
            <label class="block text-sm font-bold text-[#1A3533] mb-2" style="font-family: var(--font-heading);">
              2. Um was für einen Wunsch handelt es sich? <span class="text-[#FF8A34]">*</span>
            </label>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 border-[#58CBBF]/20 bg-[#F0FCFB]/30 hover:bg-[#F0FCFB] cursor-pointer text-center transition-all has-[:checked]:border-[#FF8A34] has-[:checked]:bg-[#FF8A34]/10 has-[:checked]:text-[#FF8A34]">
                <input type="radio" name="category" value="Neues Feature" checked class="sr-only" />
                <span class="text-xl mb-1">💡</span>
                <span class="text-xs font-bold leading-tight">Neues Feature</span>
              </label>

              <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 border-[#58CBBF]/20 bg-[#F0FCFB]/30 hover:bg-[#F0FCFB] cursor-pointer text-center transition-all has-[:checked]:border-[#FF8A34] has-[:checked]:bg-[#FF8A34]/10 has-[:checked]:text-[#FF8A34]">
                <input type="radio" name="category" value="Neue Aufgaben/Level" class="sr-only" />
                <span class="text-xl mb-1">🎨</span>
                <span class="text-xs font-bold leading-tight">Aufgaben / Level</span>
              </label>

              <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 border-[#58CBBF]/20 bg-[#F0FCFB]/30 hover:bg-[#F0FCFB] cursor-pointer text-center transition-all has-[:checked]:border-[#FF8A34] has-[:checked]:bg-[#FF8A34]/10 has-[:checked]:text-[#FF8A34]">
                <input type="radio" name="category" value="Fehler / Verbesserung" class="sr-only" />
                <span class="text-xl mb-1">🐞</span>
                <span class="text-xs font-bold leading-tight">Fehler melden</span>
              </label>

              <label class="relative flex flex-col items-center justify-center p-3 rounded-2xl border-2 border-[#58CBBF]/20 bg-[#F0FCFB]/30 hover:bg-[#F0FCFB] cursor-pointer text-center transition-all has-[:checked]:border-[#FF8A34] has-[:checked]:bg-[#FF8A34]/10 has-[:checked]:text-[#FF8A34]">
                <input type="radio" name="category" value="Lob & Feedback" class="sr-only" />
                <span class="text-xl mb-1">💬</span>
                <span class="text-xs font-bold leading-tight">Lob & Feedback</span>
              </label>
            </div>
          </div>

          <!-- 3. Titel der Idee -->
          <div>
            <label for="idea-title" class="block text-sm font-bold text-[#1A3533] mb-1.5" style="font-family: var(--font-heading);">
              3. Kurztitel deiner Idee <span class="text-[#FF8A34]">*</span>
            </label>
            <input 
              type="text" 
              id="idea-title" 
              name="title" 
              required
              maxlength="120"
              placeholder="z. B. Multiplikationstabelle bis 100 oder Nachtmodus" 
              class="w-full px-4 py-3 rounded-2xl bg-[#F0FCFB]/40 border-2 border-[#58CBBF]/30 text-sm font-medium text-[#1A3533] placeholder-slate-400 focus:outline-none focus:border-[#00897B] focus:bg-white transition-colors"
            />
          </div>

          <!-- 4. Beschreibung -->
          <div>
            <label for="idea-description" class="block text-sm font-bold text-[#1A3533] mb-1.5" style="font-family: var(--font-heading);">
              4. Wie soll das Feature funktionieren? <span class="text-[#FF8A34]">*</span>
            </label>
            <textarea 
              id="idea-description" 
              name="description" 
              rows="4" 
              required
              maxlength="2000"
              placeholder="Erzähle uns möglichst genau, was dir vorschwebt. Was soll passieren? Warum würde das Kindern beim Lernen oder Spielen helfen?"
              class="w-full px-4 py-3 rounded-2xl bg-[#F0FCFB]/40 border-2 border-[#58CBBF]/30 text-sm font-medium text-[#1A3533] placeholder-slate-400 focus:outline-none focus:border-[#00897B] focus:bg-white transition-colors leading-relaxed"
            ></textarea>
          </div>

          <!-- 5. Datei-Upload (Bilder & PDF bis 10 MB) -->
          <div>
            <label class="block text-sm font-bold text-[#1A3533] mb-1.5" style="font-family: var(--font-heading);">
              5. Skizze, Zeichnung oder Screenshot anhängen <span class="text-xs font-normal text-[#527976]">(Optional, max. 10 MB)</span>
            </label>
            <div 
              id="dropzone"
              class="relative rounded-2xl border-2 border-dashed border-[#58CBBF]/40 bg-[#F0FCFB]/30 hover:bg-[#F0FCFB]/60 p-6 text-center transition-all cursor-pointer group"
            >
              <input 
                type="file" 
                id="file-input" 
                name="attachment" 
                accept="image/png, image/jpeg, image/webp, application/pdf"
                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" 
              />
              
              <div id="dropzone-idle" class="flex flex-col items-center">
                <div class="w-12 h-12 rounded-2xl bg-white shadow-sm flex items-center justify-center text-2xl text-[#00897B] mb-2 group-hover:scale-110 transition-transform">
                  📎
                </div>
                <p class="text-xs sm:text-sm font-bold text-[#1A3533]">
                  Klicke hier oder ziehe eine Datei hierher
                </p>
                <p class="text-[11px] text-[#527976] mt-1">
                  Erlaubt: PNG, JPG, WEBP oder PDF (bis 10 MB)
                </p>
              </div>

              <!-- Selected File Preview -->
              <div id="file-preview" class="hidden flex items-center justify-between bg-white p-3 rounded-xl border border-[#58CBBF]/30 text-left">
                <div class="flex items-center gap-3 overflow-hidden">
                  <span class="text-2xl flex-shrink-0" id="file-icon">📄</span>
                  <div class="overflow-hidden">
                    <p class="text-xs font-bold text-[#1A3533] truncate" id="file-name"></p>
                    <p class="text-[10px] text-[#527976]" id="file-size"></p>
                  </div>
                </div>
                <button 
                  type="button" 
                  id="btn-remove-file" 
                  class="p-1 rounded-lg text-rose-500 hover:bg-rose-50 transition-colors flex-shrink-0 z-20"
                  title="Datei entfernen"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M18 6 6 18M6 6l12 12"/>
                  </svg>
                </button>
              </div>
            </div>
            <p id="file-error" class="hidden text-xs text-rose-600 font-semibold mt-1.5 flex items-center gap-1">
              <span>⚠️</span> <span id="file-error-text"></span>
            </p>
          </div>

          <!-- 6. Optionale Kontaktdaten -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-slate-100">
            <div>
              <label for="sender-name" class="block text-xs font-bold text-[#1A3533] mb-1" style="font-family: var(--font-heading);">
                Dein Name / Pseudonym <span class="text-xs font-normal text-[#527976]">(Freiwillig)</span>
              </label>
              <input 
                type="text" 
                id="sender-name" 
                name="name" 
                placeholder="z. B. Max oder Familie Schmidt" 
                class="w-full px-4 py-2.5 rounded-xl bg-[#F0FCFB]/40 border-2 border-[#58CBBF]/30 text-sm font-medium text-[#1A3533] placeholder-slate-400 focus:outline-none focus:border-[#00897B] focus:bg-white transition-colors"
              />
            </div>
            <div>
              <label for="sender-email" class="block text-xs font-bold text-[#1A3533] mb-1" style="font-family: var(--font-heading);">
                Deine E-Mail-Adresse <span class="text-xs font-normal text-[#527976]">(Freiwillig, für Antworten)</span>
              </label>
              <input 
                type="email" 
                id="sender-email" 
                name="email" 
                placeholder="kontakt@beispiel.de" 
                class="w-full px-4 py-2.5 rounded-xl bg-[#F0FCFB]/40 border-2 border-[#58CBBF]/30 text-sm font-medium text-[#1A3533] placeholder-slate-400 focus:outline-none focus:border-[#00897B] focus:bg-white transition-colors"
              />
            </div>
          </div>

          <!-- 7. Datenschutz-Zustimmung & Checkbox -->
          <div class="pt-2">
            <label class="flex items-start gap-3 cursor-pointer group">
              <input 
                type="checkbox" 
                id="privacy-consent" 
                name="privacy_consent" 
                required
                class="mt-1 w-4 h-4 rounded text-[#00897B] border-[#58CBBF] focus:ring-[#00897B] cursor-pointer" 
              />
              <span class="text-xs text-[#4B6E6A] leading-relaxed">
                Ich bin einverstanden, dass meine Angaben und eventuell angehängte Dateien zur Bearbeitung meines Feature-Wunsches verarbeitet werden. Es erfolgt keine Weitergabe an Dritte oder Werbenetzwerke. Weitere Details in unserer <a href="/datenschutz" target="_blank" class="text-[#00897B] font-bold underline">Datenschutzerklärung</a>.
              </span>
            </label>
          </div>

          <!-- Error Alert Banner (Hidden by default) -->
          <div id="submit-error" class="hidden p-4 rounded-2xl bg-rose-50 border-2 border-rose-200 text-rose-800 text-xs">
            <div class="flex items-start gap-2">
              <span class="text-base">⚠️</span>
              <div>
                <p class="font-bold" id="submit-error-title">Das Absenden hat leider nicht geklappt.</p>
                <p class="mt-1" id="submit-error-desc">Bitte überprüfe deine Internetverbindung oder sende uns deine Idee direkt per E-Mail an <a href={`mailto:${CONTACT_EMAIL}`} class="font-bold underline">{CONTACT_EMAIL}</a>.</p>
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button 
              type="submit" 
              id="submit-button"
              class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-[#FF8A34] hover:bg-[#E67520] active:scale-[0.99] text-white font-extrabold text-base shadow-lg hover:shadow-xl transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
              style="font-family: var(--font-heading);"
            >
              <span id="btn-icon">🚀</span>
              <span id="btn-text">Idee an Betty absenden</span>
            </button>
            <p class="text-[11px] text-[#527976] text-center mt-2">
              🛡️ Sicher & direkt • Spam-geschützt • Keine Cookies erforderlich
            </p>
          </div>

        </form>

      </div>

    </div>
  </div>
</Layout>

<script define:vars={{ MAX_DAILY_FEEDBACK, FEEDBACK_COOLDOWN_SECONDS, CONTACT_EMAIL }}>
  // Anti-Abuse Konfiguration & Storage Keys
  const STORAGE_KEY_COUNT = 'betty_feedback_daily_count';
  const STORAGE_KEY_DATE = 'betty_feedback_date';
  const STORAGE_KEY_LAST_SUBMIT = 'betty_feedback_last_submit';

  // State
  const pageLoadTimestamp = Date.now();
  const form = document.getElementById('feedback-form');
  const formContainer = document.getElementById('feedback-form-container');
  const successContainer = document.getElementById('feedback-success');
  const rateLimitNotice = document.getElementById('rate-limit-notice');
  const rateLimitMessage = document.getElementById('rate-limit-message');
  const submitBtn = document.getElementById('submit-button');
  const btnText = document.getElementById('btn-text');
  const btnIcon = document.getElementById('btn-icon');
  const btnAnother = document.getElementById('btn-another-idea');
  const submitError = document.getElementById('submit-error');
  const fileInput = document.getElementById('file-input');
  const dropzoneIdle = document.getElementById('dropzone-idle');
  const filePreview = document.getElementById('file-preview');
  const fileName = document.getElementById('file-name');
  const fileSize = document.getElementById('file-size');
  const fileError = document.getElementById('file-error');
  const fileErrorText = document.getElementById('file-error-text');
  const btnRemoveFile = document.getElementById('btn-remove-file');
  const appSelect = document.getElementById('app-select');
  const emailSubject = document.getElementById('email-subject');

  // 1. URL Parameter Auswertung: Vorauswahl der App (?app=fokus-mit-betty)
  const urlParams = new URLSearchParams(window.location.search);
  const requestedApp = urlParams.get('app');
  if (requestedApp && appSelect) {
    const matchingOption = Array.from(appSelect.options).find(opt => opt.value === requestedApp);
    if (matchingOption) {
      appSelect.value = requestedApp;
      if (emailSubject) {
        emailSubject.value = `💡 Idee für ${matchingOption.text}`;
      }
    }
  }

  // Bei Änderung des Dropdowns Betreff aktualisieren
  if (appSelect && emailSubject) {
    appSelect.addEventListener('change', () => {
      const selectedText = appSelect.options[appSelect.selectedIndex]?.text || '';
      emailSubject.value = `💡 Idee für ${selectedText}`;
    });
  }

  // 2. Anti-Abuse: Tageslimit & Cooldown prüfen
  function checkRateLimits() {
    const today = new Date().toISOString().slice(0, 10);
    const storedDate = localStorage.getItem(STORAGE_KEY_DATE);
    let count = parseInt(localStorage.getItem(STORAGE_KEY_COUNT) || '0', 10);

    if (storedDate !== today) {
      // Neuer Tag: Zähler zurücksetzen
      count = 0;
      localStorage.setItem(STORAGE_KEY_DATE, today);
      localStorage.setItem(STORAGE_KEY_COUNT, '0');
    }

    // A. Tageslimit-Check
    if (count >= MAX_DAILY_FEEDBACK) {
      if (rateLimitNotice && rateLimitMessage) {
        rateLimitMessage.textContent = `Du hast heute bereits ${count} Ideen eingereicht. Um unsere Mailbox vor Spam zu schützen, ist das Tageslimit erreicht. Morgen kannst du wieder neue Vorschläge schicken!`;
        rateLimitNotice.classList.remove('hidden');
      }
      if (submitBtn) {
        submitBtn.disabled = true;
        btnText.textContent = 'Tageslimit erreicht';
        btnIcon.textContent = '⏸️';
      }
      return false;
    }

    // B. Cooldown-Check (z. B. 60 Sekunden zwischen zwei Einsendungen)
    const lastSubmitTime = parseInt(localStorage.getItem(STORAGE_KEY_LAST_SUBMIT) || '0', 10);
    const elapsedSeconds = Math.floor((Date.now() - lastSubmitTime) / 1000);
    if (elapsedSeconds < FEEDBACK_COOLDOWN_SECONDS) {
      const remainingSeconds = FEEDBACK_COOLDOWN_SECONDS - elapsedSeconds;
      if (submitBtn) {
        submitBtn.disabled = true;
        btnText.textContent = `Pause (${remainingSeconds}s)`;
        btnIcon.textContent = '⏳';
      }
      // Countdown Timer
      const interval = setInterval(() => {
        const nowElapsed = Math.floor((Date.now() - lastSubmitTime) / 1000);
        const rem = FEEDBACK_COOLDOWN_SECONDS - nowElapsed;
        if (rem <= 0) {
          clearInterval(interval);
          submitBtn.disabled = false;
          btnText.textContent = 'Idee an Betty absenden';
          btnIcon.textContent = '🚀';
        } else {
          btnText.textContent = `Pause (${rem}s)`;
        }
      }, 1000);
      return false;
    }

    return true;
  }

  // Initiale Prüfung
  checkRateLimits();

  // 3. Datei-Upload Validierung & Vorschau
  if (fileInput) {
    fileInput.addEventListener('change', () => {
      fileError.classList.add('hidden');
      const file = fileInput.files[0];
      if (!file) {
        resetFileInput();
        return;
      }

      // Max 10 MB (10 * 1024 * 1024 Bytes)
      const MAX_SIZE = 10 * 1024 * 1024;
      if (file.size > MAX_SIZE) {
        fileErrorText.textContent = `Die Datei ist mit ${(file.size / (1024 * 1024)).toFixed(1)} MB zu groß. Maximal 10 MB erlaubt.`;
        fileError.classList.remove('hidden');
        resetFileInput();
        return;
      }

      // Dateiformat prüfen
      const validTypes = ['image/png', 'image/jpeg', 'image/webp', 'application/pdf'];
      if (!validTypes.includes(file.type)) {
        fileErrorText.textContent = 'Erlaubt sind nur PNG, JPG, WEBP oder PDF.';
        fileError.classList.remove('hidden');
        resetFileInput();
        return;
      }

      // Erfolgreich ausgewählt: Vorschau anzeigen
      fileName.textContent = file.name;
      const sizeFormatted = file.size > 1024 * 1024 
        ? `${(file.size / (1024 * 1024)).toFixed(1)} MB`
        : `${Math.round(file.size / 1024)} KB`;
      fileSize.textContent = sizeFormatted;

      dropzoneIdle.classList.add('hidden');
      filePreview.classList.remove('hidden');
    });
  }

  function resetFileInput() {
    if (fileInput) fileInput.value = '';
    if (dropzoneIdle) dropzoneIdle.classList.remove('hidden');
    if (filePreview) filePreview.classList.add('hidden');
  }

  if (btnRemoveFile) {
    btnRemoveFile.addEventListener('click', (e) => {
      e.stopPropagation();
      resetFileInput();
    });
  }

  // 4. Formular-Absenden via AJAX (Web3Forms)
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitError.classList.add('hidden');

      // A. Bot-Timegate Check (< 3 Sekunden nach Page Load = Bot)
      const fillDuration = Date.now() - pageLoadTimestamp;
      if (fillDuration < 3000) {
        console.warn('Submission too fast, flagged as automated.');
        // Lautlos blockieren, um Bots keine Hinweise zu geben
        return;
      }

      // B. Honeypot Check
      const botcheck = form.querySelector('input[name="botcheck"]');
      if (botcheck && botcheck.checked) {
        console.warn('Honeypot triggered.');
        return;
      }

      // C. Rate Limit Check
      const allowed = checkRateLimits();
      if (!allowed) {
        return;
      }

      // UI: Ladezustand aktivieren
      submitBtn.disabled = true;
      btnText.textContent = 'Wird an Betty übertragen... 🐾';
      btnIcon.textContent = '✨';

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (response.status === 200 && data.success) {
          // Rate Limit Daten aktualisieren
          const today = new Date().toISOString().slice(0, 10);
          let currentCount = parseInt(localStorage.getItem(STORAGE_KEY_COUNT) || '0', 10);
          localStorage.setItem(STORAGE_KEY_DATE, today);
          localStorage.setItem(STORAGE_KEY_COUNT, (currentCount + 1).toString());
          localStorage.setItem(STORAGE_KEY_LAST_SUBMIT, Date.now().toString());

          // Formular verstecken, Erfolgsmeldung anzeigen
          formContainer.classList.add('hidden');
          successContainer.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          throw new Error(data.message || 'Übertragung fehlgeschlagen');
        }
      } catch (err) {
        console.error('Submission error:', err);
        submitError.classList.remove('hidden');
        submitBtn.disabled = false;
        btnText.textContent = 'Erneut versuchen';
        btnIcon.textContent = '🔄';
      }
    });
  }

  // 5. "Noch eine Idee einreichen" Button Handler
  if (btnAnother) {
    btnAnother.addEventListener('click', () => {
      form.reset();
      resetFileInput();
      successContainer.classList.add('hidden');
      formContainer.classList.remove('hidden');
      submitBtn.disabled = false;
      btnText.textContent = 'Idee an Betty absenden';
      btnIcon.textContent = '🚀';
      checkRateLimits();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
