---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
const appsHash = isEn ? '/en/#apps' : '#apps';
const safetyHash = isEn ? '/en/#safety' : '#safety';
---

<section class="relative overflow-hidden pt-10 pb-16 lg:pt-16 lg:pb-24">
  <!-- Subtle decorative background blobs -->
  <div class="absolute top-12 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full -z-10 pointer-events-none opacity-60">
    <div class="absolute -top-10 left-10 w-72 h-72 rounded-full bg-[#B2EBE6]/60 blur-3xl"></div>
    <div class="absolute top-20 right-10 w-80 h-80 rounded-full bg-[#FDD5B4]/50 blur-3xl"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text & Value Prop -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Betty's Tag Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/90 border border-[#58CBBF]/40 shadow-xs text-xs sm:text-sm font-bold text-[#00897B]">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-[#43A047] animate-pulse"></span>
          <span>{isEn ? "Welcome to Betty's colorful learning world!" : "Willkommen in Bettys bunter Lernwelt!"}</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#1A3533] leading-[1.15]" style="font-family: var(--font-heading);">
          {isEn ? 'Learning with Heart, ' : 'Lernen mit Herz, '}<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00897B] via-[#58CBBF] to-[#E8935C]">
            {isEn ? 'Joy and Curiosity.' : 'Spaß und Köpfchen.'}
          </span>
        </h1>

        <p class="text-base sm:text-lg text-[#4B6E6A] leading-relaxed max-w-xl mx-auto lg:mx-0">
          {isEn 
            ? 'Whether concentration training, mental math, first English words, or fast-paced paw action: With Betty the poodle, children joyfully discover their strengths. Built with love for curious kids and true peace of mind for parents.'
            : 'Ob Konzentrationstraining, Kopfrechnen, erstes Englisch oder rasante Pfoten-Action: Mit Hündin Betty entdecken Kinder spielerisch ihre Stärken. Entwickelt mit Liebe für kleine Entdecker und ein gutes Gefühl bei Eltern.'}
        </p>

        <!-- Feature Pills -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 pt-2 text-xs font-bold text-[#1A3533]">
          <span class="px-3 py-1.5 rounded-xl bg-white/80 border border-[#B2EBE6] shadow-xs flex items-center gap-1.5">
            <span class="text-emerald-600">✓</span> {isEn ? 'Local Progress (No Accounts)' : 'Lokale Lernstände (Keine Konten)'}
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-white/80 border border-[#B2EBE6] shadow-xs flex items-center gap-1.5">
            <span class="text-emerald-600">✓</span> {isEn ? 'No Ad-ID Tracking' : 'Kein Werbe-ID Tracking'}
          </span>
          <span class="px-3 py-1.5 rounded-xl bg-white/80 border border-[#B2EBE6] shadow-xs flex items-center gap-1.5">
            <span class="text-emerald-600">✓</span> {isEn ? 'Google Play Family Program' : 'Google Play Familienprogramm'}
          </span>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
          <a 
            href={appsHash} 
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-2xl bg-[#FF8A34] hover:bg-[#E67520] text-white font-extrabold text-base shadow-lg shadow-[#FF8A34]/25 hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 transition-all text-center"
            style="font-family: var(--font-heading);"
          >
            {isEn ? 'Explore All 4 Apps' : 'Alle 4 Apps entdecken'}
            <svg class="w-5 h-5 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14"></path>
              <path d="m19 12-7 7-7-7"></path>
            </svg>
          </a>
          <a 
            href={safetyHash} 
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-2xl bg-white hover:bg-[#F0FCFB] text-[#00897B] border border-[#58CBBF]/40 font-bold text-base shadow-sm hover:shadow transition-all text-center"
            style="font-family: var(--font-heading);"
          >
            {isEn ? '🛡️ The Betty Safety Promise' : '🛡️ Das Betty-Sicherheitsversprechen'}
          </a>
        </div>

      </div>

      <!-- Hero Mascot Presentation -->
      <div class="lg:col-span-5 relative flex justify-center">
        <!-- Circular card container with soft shadow -->
        <div class="relative w-72 sm:w-88 lg:w-full max-w-md aspect-square rounded-[2.5rem] bg-gradient-to-b from-white via-white/90 to-[#B2EBE6]/40 p-4 shadow-xl border-4 border-white flex items-center justify-center overflow-hidden group">
          
          <!-- Background glow -->
          <div class="absolute inset-0 bg-radial from-[#58CBBF]/20 to-transparent"></div>
          
          <img 
            src="/images/mascot/betty_mascot_welcome.png" 
            alt="Hündin Betty begrüßt dich" 
            class="relative z-10 w-full h-auto object-contain max-h-[92%] drop-shadow-md group-hover:scale-105 transition-transform duration-500"
            loading="eager"
          />

          <!-- Floating badge: Hallo Freunde! -->
          <div class="absolute bottom-4 left-4 z-20 bg-white/95 backdrop-blur-xs px-4 py-2 rounded-2xl shadow-md border border-[#58CBBF]/30 flex items-center gap-2">
            <span class="text-xl">🐶</span>
            <div>
              <div class="text-xs font-extrabold text-[#1A3533]" style="font-family: var(--font-heading);">
                Hi, ich bin Betty!
              </div>
              <div class="text-[10px] text-[#527976] font-medium">Lern mit mir!</div>
            </div>
          </div>

          <!-- Floating badge: 4 Apps -->
          <div class="absolute top-4 right-4 z-20 bg-[#FF8A34] text-white px-3.5 py-1.5 rounded-2xl shadow-md font-bold text-xs flex items-center gap-1.5" style="font-family: var(--font-heading);">
            <span>⭐</span> 4 Apps für Kinder
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
