---
import type { AppItem } from '../data/apps';

interface Props {
  app: AppItem;
}

const { app } = Astro.props;
---

<div 
  id={app.id} 
  class="relative rounded-[2rem] bg-white border-2 border-[#58CBBF]/20 p-6 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between group"
>
  <div>
    <!-- Top Bar: Icon + Category & Age Badges -->
    <div class="flex items-start justify-between gap-4 mb-6">
      
      <!-- App Launcher Icon -->
      <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-3xl p-1 bg-white shadow-md border-2 border-slate-100 flex-shrink-0 group-hover:scale-105 transition-transform duration-300 overflow-hidden">
        <img 
          src={app.icon} 
          alt={`App Icon ${app.name}`} 
          class="w-full h-full object-cover rounded-2xl"
          loading="lazy"
        />
      </div>

      <!-- Badges -->
      <div class="flex flex-col items-end gap-2 text-right">
        <span class={`text-xs font-bold px-3 py-1 rounded-full border ${app.badgeBg}`}>
          {app.category}
        </span>
        <span class="text-xs font-semibold text-[#527976] bg-slate-100 px-2.5 py-1 rounded-lg">
          🎯 {app.targetAge}
        </span>
      </div>

    </div>

    <!-- Title & Tagline -->
    <h3 class="text-2xl font-extrabold text-[#1A3533] mb-1 group-hover:text-[#00897B] transition-colors" style="font-family: var(--font-heading);">
      {app.name}
    </h3>
    <p class="text-sm font-semibold text-[#E8935C] mb-3">
      {app.tagline}
    </p>

    <!-- Description -->
    <p class="text-sm text-[#4B6E6A] leading-relaxed mb-6">
      {app.description}
    </p>

    <!-- Key Highlights / Didactics -->
    <div class="space-y-2 mb-8 bg-[#F0FCFB]/60 p-4 rounded-2xl border border-[#58CBBF]/15">
      <div class="text-xs font-bold uppercase tracking-wider text-[#00897B] mb-2" style="font-family: var(--font-heading);">
        Was dein Kind lernt:
      </div>
      <ul class="space-y-2 text-xs text-[#1A3533]">
        {app.highlights.map((highlight) => (
          <li class="flex items-start gap-2">
            <span class="text-[#00897B] font-bold mt-0.5">✓</span>
            <span class="leading-snug">{highlight}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Action: Google Play Store Button -->
  <div class="pt-2 border-t border-slate-100">
    <a 
      href={app.playStoreUrl}
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-2xl bg-[#1A3533] hover:bg-[#00897B] text-white font-bold text-sm shadow-md hover:shadow-lg transition-all group-hover:bg-[#00897B]"
      style="font-family: var(--font-heading);"
    >
      <!-- Google Play Icon SVG -->
      <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3.609 1.814L13.792 12 3.61 22.186c-.368-.382-.61-.951-.61-1.686V3.5c0-.735.242-1.304.61-1.686zM15.207 13.414l2.122 2.122-12.02 6.84 9.898-8.962zm0-2.828L5.309 1.624l12.02 6.84-2.122 2.122zm1.414 1.414l3.693 2.102c.983.559.983 1.477 0 2.036l-3.693 2.102-1.897-1.897 1.897-4.343z"/>
      </svg>
      <div class="flex flex-col text-left leading-none">
        <span class="text-[10px] uppercase tracking-wider font-medium text-slate-300">Jetzt herunterladen</span>
        <span class="text-sm font-extrabold mt-0.5">Google Play</span>
      </div>
    </a>
    <div class="flex items-center justify-between mt-3 pt-2 border-t border-slate-100 text-[11px]">
      <a 
        href={`/feedback?app=${app.id}`} 
        class="text-[#FF8A34] hover:text-[#E67520] font-bold flex items-center gap-1 transition-colors"
      >
        <span>💡</span> Idee für {app.name}
      </a>
      <a 
        href={app.privacyUrl} 
        class="text-[#527976] hover:text-[#00897B] font-semibold transition-colors"
      >
        🛡️ Datenschutz
      </a>
    </div>
  </div>
</div>
