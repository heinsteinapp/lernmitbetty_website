---
---

<header class="sticky top-0 z-50 bg-[#F0FCFB]/90 backdrop-blur-md border-b border-[#58CBBF]/20 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="relative w-12 h-12 rounded-2xl bg-white p-1 shadow-sm border border-[#58CBBF]/30 group-hover:scale-105 transition-transform overflow-hidden">
        <img 
          src="/images/mascot/betty_winking.png" 
          alt="Hündin Betty Mascot" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col">
        <span class="text-2xl font-bold tracking-tight text-[#1A3533] group-hover:text-[#00897B] transition-colors leading-none" style="font-family: var(--font-heading);">
          Lern mit Betty<span class="text-[#FF8A34]">.</span>
        </span>
        <span class="text-xs font-semibold text-[#527976] mt-1 tracking-wider uppercase">
          Lern- & Kinder-Apps
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-[#1A3533]">
      <a href="/#apps" class="hover:text-[#00897B] transition-colors py-1">
        Unsere Apps
      </a>
      <a href="/#safety" class="hover:text-[#00897B] transition-colors py-1">
        Sicherheit & Vertrauen
      </a>
      <a href="/#parents" class="hover:text-[#00897B] transition-colors py-1">
        Für Eltern
      </a>
      <a href="/datenschutz" class="hover:text-[#00897B] transition-colors py-1 text-slate-700">
        Datenschutz
      </a>
    </nav>

    <!-- CTA Button -->
    <div class="flex items-center gap-3">
      <a 
        href="/#apps" 
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-[#FF8A34] hover:bg-[#E67520] text-white font-bold text-sm shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 active:translate-y-0"
        style="font-family: var(--font-heading);"
      >
        <svg class="w-4 h-4 mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
        Apps entdecken
      </a>
    </div>
  </div>
</header>
