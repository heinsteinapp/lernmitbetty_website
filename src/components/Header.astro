---
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';

const homeUrl = isEn ? '/en/' : '/';
const appsUrl = isEn ? '/en/#apps' : '/#apps';
const safetyUrl = isEn ? '/en/#safety' : '/#safety';
const parentsUrl = isEn ? '/en/#parents' : '/#parents';
const feedbackUrl = isEn ? '/en/feedback/' : '/feedback';
const privacyUrl = '/datenschutz';
---

<header class="sticky top-0 z-50 bg-[#F0FCFB]/90 backdrop-blur-md border-b border-[#58CBBF]/20 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-3 group">
      <div class="relative w-12 h-12 rounded-2xl bg-white p-1 shadow-sm border border-[#58CBBF]/30 group-hover:scale-105 transition-transform overflow-hidden">
        <img 
          src="/images/mascot/betty_winking.png" 
          alt="Hündin Betty Mascot" 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col">
        <span class="text-2xl font-bold tracking-tight text-[#1A3533] group-hover:text-[#00897B] transition-colors leading-none" style="font-family: var(--font-heading);">
          {isEn ? 'Learn with Betty' : 'Lern mit Betty'}<span class="text-[#FF8A34]">.</span>
        </span>
        <span class="text-xs font-semibold text-[#527976] mt-1 tracking-wider uppercase">
          {isEn ? 'Educational Apps for Kids' : 'Lern- & Kinder-Apps'}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-semibold text-[#1A3533]">
      <a href={appsUrl} class="hover:text-[#00897B] transition-colors py-1">
        {isEn ? 'Our Apps' : 'Unsere Apps'}
      </a>
      <a href={safetyUrl} class="hover:text-[#00897B] transition-colors py-1">
        {isEn ? 'Safety & Trust' : 'Sicherheit & Vertrauen'}
      </a>
      <a href={parentsUrl} class="hover:text-[#00897B] transition-colors py-1">
        {isEn ? 'For Parents' : 'Für Eltern'}
      </a>
      <a href={feedbackUrl} class="hover:text-[#00897B] transition-colors py-1 flex items-center gap-1.5 text-[#E8935C] hover:text-[#FF8A34]">
        <span>💡</span> {isEn ? 'Ideas & Feedback' : 'Ideen & Feedback'}
      </a>
      <a href={privacyUrl} class="hover:text-[#00897B] transition-colors py-1 text-slate-700">
        {isEn ? 'Privacy' : 'Datenschutz'}
      </a>
    </nav>

    <!-- Right Actions: Language Picker + CTA Button -->
    <div class="flex items-center gap-2 sm:gap-3">
      <LanguagePicker currentLang={lang} />

      <a 
        href={appsUrl} 
        class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 rounded-full bg-[#FF8A34] hover:bg-[#E67520] text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 active:translate-y-0"
        style="font-family: var(--font-heading);"
      >
        <svg class="w-4 h-4 mr-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
        {isEn ? 'Explore Apps' : 'Apps entdecken'}
      </a>
    </div>
  </div>
</header>
