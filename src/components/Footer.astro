---
interface Props {
  lang?: 'de' | 'en';
}

const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
const currentYear = new Date().getFullYear();

const homeUrl = isEn ? '/en/' : '/';
const fokusUrl = isEn ? '/en/#fokus-mit-betty' : '/#fokus-mit-betty';
const rechnenUrl = isEn ? '/en/#rechnen-mit-betty' : '/#rechnen-mit-betty';
const englischUrl = isEn ? '/en/#englisch-mit-betty' : '/#englisch-mit-betty';
const sliceUrl = isEn ? '/en/#betty-slice' : '/#betty-slice';
const feedbackUrl = isEn ? '/en/feedback/' : '/feedback';
const safetyUrl = isEn ? '/en/#safety' : '/#safety';
const admobUrl = isEn ? '/en/admob/' : '/admob';
---

<footer class="bg-white border-t border-[#58CBBF]/20 mt-20 pt-16 pb-12 text-[#1A3533]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-100">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-[#F0FCFB] p-1 border border-[#58CBBF]/30 overflow-hidden">
            <img src="/images/mascot/betty_winking.png" alt="Betty" class="w-full h-full object-cover" />
          </div>
          <span class="text-xl font-bold tracking-tight" style="font-family: var(--font-heading);">
            {isEn ? 'Learn with Betty' : 'Lern mit Betty'}<span class="text-[#FF8A34]">.</span>
          </span>
        </div>
        <p class="text-sm text-[#4B6E6A] leading-relaxed max-w-md">
          {isEn 
            ? "Thoughtfully crafted educational and dexterity apps for children. We combine child-friendly pedagogy, encouraging motivation, and 100% privacy – with zero tracking, no data sales, and no sensory overload."
            : "Liebevoll gestaltete Lern- und Geschicklichkeits-Apps für Kinder. Wir verbinden kindgerechte Pädagogik, hohe Motivation und 100 % Privatsphäre – ohne Tracking, ohne Datenverkäufe und ohne Überreizung."}
        </p>
        <div class="flex items-center gap-2 text-xs font-semibold text-[#00897B] bg-[#F0FCFB] px-3 py-2 rounded-xl inline-block border border-[#58CBBF]/20">
          {isEn ? "🛡️ Google Play Family Program & COPPA Compliant" : "🛡️ Konform mit Google Play Familienprogramm & COPPA"}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-slate-800 mb-4" style="font-family: var(--font-heading);">
          {isEn ? 'Our Apps' : 'Unsere Apps'}
        </h4>
        <ul class="space-y-2.5 text-sm text-[#4B6E6A]">
          <li>
            <a href={fokusUrl} class="hover:text-[#00897B] transition-colors">
              {isEn ? 'Focus with Betty' : 'Fokus mit Betty'}
            </a>
          </li>
          <li>
            <a href={rechnenUrl} class="hover:text-[#00897B] transition-colors">
              {isEn ? 'Count on Betty' : 'Rechne mit Betty'}
            </a>
          </li>
          <li>
            <a href={englischUrl} class="hover:text-[#00897B] transition-colors">
              {isEn ? 'Learn English with Betty' : 'Englisch mit Betty'}
            </a>
          </li>
          <li>
            <a href={sliceUrl} class="hover:text-[#00897B] transition-colors">
              Betty's Slice
            </a>
          </li>
          <li class="pt-1 border-t border-slate-100 mt-2">
            <a href={feedbackUrl} class="text-[#FF8A34] hover:text-[#E67520] font-semibold transition-colors flex items-center gap-1">
              <span>💡</span> {isEn ? 'Request a Feature' : 'Feature wünschen'}
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal & Info -->
      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-slate-800 mb-4" style="font-family: var(--font-heading);">
          {isEn ? 'Legal & Info' : 'Rechtliches & Compliance'}
        </h4>
        <ul class="space-y-2.5 text-sm text-[#4B6E6A]">
          <li>
            <a href="/datenschutz" class="hover:text-[#00897B] transition-colors font-medium">
              {isEn ? 'Privacy Policies (Hub)' : 'Datenschutzerklärungen (Hub)'}
            </a>
          </li>
          <li>
            <a href={admobUrl} class="hover:text-[#00897B] transition-colors font-medium">
              {isEn ? 'Google AdMob & Child Safety' : 'Google AdMob & Kinderschutz'}
            </a>
          </li>
          <li>
            <a href="/impressum" class="hover:text-[#00897B] transition-colors font-medium">
              {isEn ? 'Legal Notice / Imprint' : 'Impressum & Anbieter'}
            </a>
          </li>
          <li>
            <a href={safetyUrl} class="hover:text-[#00897B] transition-colors">
              {isEn ? 'Safety Promise' : 'Sicherheitsversprechen'}
            </a>
          </li>
          <li>
            <a href="mailto:heinstein.app@gmail.com" class="hover:text-[#00897B] transition-colors">
              heinstein.app@gmail.com
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Copyright & Disclaimer -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#527976] gap-4">
      <div>
        &copy; {currentYear} {isEn ? 'Learn with Betty. All rights reserved.' : 'Lern mit Betty. Alle Rechte vorbehalten.'}
      </div>
      <div class="flex items-center gap-4">
        <span>Made with ❤️ for curious kids</span>
        <span>•</span>
        <a href="https://play.google.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#00897B]">
          Google Play Store
        </a>
      </div>
    </div>
  </div>
</footer>
