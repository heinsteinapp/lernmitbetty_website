---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Lern mit Betty | Kindgerechte Lern- und Konzentrations-Apps",
  description = "Entdecke Fokus mit Betty, Rechne mit Betty, Englisch mit Betty und Betty's Slice. 100% sichere, werbefreie und wertebasierte Apps für Kinder.",
  image = "/images/mascot/betty_mascot_welcome.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://lernmitbetty.de");
---

<!doctype html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical & SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:locale" content="de_DE" />

    <!-- Local Fonts (Fredoka & Nunito loaded locally in global.css, 100% DSGVO-konform) -->
  </head>
  <body class="min-h-screen flex flex-col bg-[#F0FCFB] text-[#1A3533] selection:bg-[#58CBBF]/30 selection:text-[#00897B]">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
